{
  "name": "GRSP Correlator",
  "version": "0.1.2",
  "type": "standalone-postprocessor",
  "runtime": "Python 3.10+ standard library",
  "inputs": {
    "grsp": "0.5.x public capture",
    "cet": "v3.0.0-alpha6b-compatible runtime-profiler output",
    "capframex": "CapFrameX JSON"
  },
  "outputs": [
    "GRSP_Combined_Report.html",
    "GRSP_Combined_Frames.csv",
    "GRSP_Combined_Timeline.csv",
    "GRSP_Combined_Hitches.csv",
    "GRSP_Analysis.json",
    "GRSP_AI_Analysis.md",
    "GRSP_Analysis_Package.zip",
    "GRSP_Correlator_Status.txt"
  ],
  "timeline_bucket_ms": 50,
  "alignment": {
    "grsp_cet": "Unix epoch anchor from CET CAPTURE_START marker",
    "capframex_grsp": "automatic frametime-sequence correlation"
  },
  "measurement_policy": {
    "additive_remainder": false,
    "causal_verdicts": false,
    "uninstall_recommendations": false
  },
  "reference_validation": {
    "grsp_cet_start_delta_ms": 3.0,
    "grsp_cet_duration_delta_ms": 16.832,
    "capx_grsp_frame_offset": 2,
    "frametime_correlation": 0.972681,
    "median_abs_frame_duration_delta_ms": 0.5878
  },
  "startup": {
    "double_click": "native file picker; fallback console path prompt",
    "drag_drop": "supported",
    "cli": "supported",
    "auto_open_report": true,
    "hold_console_on_interactive_error": true,
    "reveal_output_folder": true
  }
}
